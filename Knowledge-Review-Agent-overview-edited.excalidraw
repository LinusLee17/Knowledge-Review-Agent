    {
      "id": "text-009",
      "type": "text",
      "x": 1190,
      "y": 220,
      "width": 1100,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#152033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1009,
      "version": 3,
      "versionNonce": 1074888939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784108625099,
      "link": null,
      "locked": false,
      "text": "One coherent repository. One canonical page per concept.",
      "originalText": "One coherent repository. One canonical page per concept.",
      "fontSize": 25,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "isText": true,
      "fontStyle": "bold"
    },
    {
      "id": "text-010",
      "type": "text",
      "x": 1190.641125416933,
      "y": 272.56020975165114,
      "width": 1100,
      "height": 135,
      "angle": 0,
      "strokeColor": "#5c6b84",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1010,
      "version": 195,
      "versionNonce": 12695141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784117540771,
      "link": null,
      "locked": false,
      "text": "Lecture material  ->  key concepts  ->  one connected repository\n\nCross-course overlap becomes an advantage instead of duplication.\nIt uses evidence from contributing courses, refines and supplements it.\n\nResult: a smaller, more useful knowledge base than having to search through a large archive of slides.",
      "originalText": "Lecture material  ->  key concepts  ->  one connected repository\n\nCross-course overlap becomes an advantage instead of duplication.\nIt uses evidence from contributing courses, refines and supplements it.\n\nResult: a smaller, more useful knowledge base than having to search through a large archive of slides.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "isText": true,
      "fontStyle": "normal"
    },
