      "text": "06  FUTURE IMPROVEMENTS & EXTENSIONS",
      "originalText": "06  FUTURE IMPROVEMENTS & EXTENSIONS",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
