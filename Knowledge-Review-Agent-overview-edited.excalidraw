    {
      "id": "text-005",
      "type": "text",
      "x": 110,
      "y": 220,
      "width": 960,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#152033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1005,
      "version": 21,
      "versionNonce": 2050972907,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784125433939,
      "link": null,
      "locked": false,
      "text": "University knowledge is long, scattered, and easy to forget.",
      "originalText": "University knowledge is long, scattered, and easy to forget.",
      "fontSize": 25,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "isText": true,
      "fontStyle": "bold"
    },
    {
      "id": "text-006",
      "type": "text",
      "x": 110,
      "y": 286,
      "width": 960,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#5c6b84",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1006,
      "version": 202,
      "versionNonce": 2093230213,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784108534618,
      "link": null,
      "locked": false,
      "text": "Coming to the end of university, I have taken many courses and accumulated many lecture notes.\nLecture notes can run hundreds of pages; concepts learnt often fade after exams.\nDifferent courses often teach overlapping concepts.\n\nNeed: fast, reliable review of concepts worth keeping for interviews and future work.",
      "originalText": "Coming to the end of university, I have taken many courses and accumulated many lecture notes.\nLecture notes can run hundreds of pages; concepts learnt often fade after exams.\nDifferent courses often teach overlapping concepts.\n\nNeed: fast, reliable review of concepts worth keeping for interviews and future work.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "isText": true,
      "fontStyle": "normal"
    },
    {
